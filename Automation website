package Selenium_test;

import java.time.Duration;
import java.util.List;

import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class FirstTest {
	static String url = "https://testautomationpractice.blogspot.com/";
	static WebDriver driver;
	//static WebDriverWait wait;  we can also declare the wait as static.

	public static void main(String[] args) {
		driver = new ChromeDriver();
		WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(5));
		driver.get(url);
		driver.manage().window().maximize();
		System.out.println("Chrome browser opened");

		FirstTest ft = new FirstTest();
		
		wait.until(ExpectedConditions.visibilityOfElementLocated(By.id("name")));
		ft.textbox("Apple", "apple@gmail.com", 9856985687L, "No.898, Banana street, Chennai 98");
		ft.radiobox();
		ft.checkbox();

		driver.manage().window().minimize();
		driver.quit();
		System.out.println("Chrome browser closed");
	}

	public void textbox(String na, String mail, long ph, String add) {
		WebElement Name = driver.findElement(By.id("name"));
		Name.sendKeys(na);
		WebElement email = driver.findElement(By.cssSelector(".form-control[placeholder = \"Enter EMail\"]"));
		email.sendKeys(mail);
		WebElement phone = driver.findElement(By.cssSelector("[placeholder = 'Enter Phone']"));
		String phoneno = String.valueOf(ph);
		phone.sendKeys(phoneno);
		WebElement address = driver.findElement(By.id("textarea"));
		address.sendKeys(add);
	}

	public void radiobox() {
		WebElement Male = driver.findElement(By.id("male"));
		Male.click();
	}

	public void checkbox() {

		List<WebElement> days = driver.findElements(By.cssSelector(".form-check-input[type='checkbox']"));
		driver.findElement(By.id("monday")).click();
		driver.findElement(By.id("tuesday")).click();
		driver.findElement(By.id("wednesday")).click();
		driver.findElement(By.id("thursday")).click();
		driver.findElement(By.id("friday")).click();

		int count = 0;
		int selected_count = 0;
		for (int i = 0; i < days.size(); i++) { //System.out.println(days.size()); - alternative for count
			count++;    //int count = days.size();      System.out.println(count); - alternative for count
		}
		System.out.println("Total days available: " + count);
		for (WebElement selected_days : days) {
			if (selected_days.isSelected() == true) {
				selected_count++;
			}
		}
		System.out.println("Days selected: "+selected_count);
	}

}

